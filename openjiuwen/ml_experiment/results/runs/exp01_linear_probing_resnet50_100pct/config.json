{
  "dataset": "oxford_flowers102",
  "data_dir": "../data",
  "image_size": 224,
  "num_classes": 102,
  "data_ratio": 1.0,
  "num_workers": 4,
  "pin_memory": true,
  "model": "resnet50",
  "pretrained": true,
  "strategy": "linear_probing",
  "partial_unfreeze_blocks": 2,
  "epochs": 20,
  "batch_size": 32,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "optimizer": "adamw",
  "scheduler": "cosine",
  "label_smoothing": 0.0,
  "early_stopping_patience": 0,
  "seed": 42,
  "results_dir": "results/runs",
  "checkpoint_dir": "checkpoints",
  "log_dir": "logs",
  "summary_csv": "results/experiments_summary.csv",
  "experiment_id": "exp01_linear_probing_resnet50_100pct",
  "experiment_name": "Linear Probing / ResNet50 / 100% data"
}