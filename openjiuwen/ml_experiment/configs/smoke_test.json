{
  "experiment_id": "smoke_test",
  "experiment_name": "Smoke Test: quick run to verify pipeline",
  "dataset": "oxford_flowers102",
  "data_dir": "../data",
  "image_size": 224,
  "num_classes": 102,
  "data_ratio": 0.1,
  "num_workers": 0,
  "pin_memory": true,
  "model": "resnet50",
  "pretrained": true,
  "strategy": "full_finetune",
  "partial_unfreeze_blocks": 2,
  "epochs": 2,
  "batch_size": 16,
  "learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "optimizer": "adamw",
  "scheduler": "cosine",
  "label_smoothing": 0.0,
  "early_stopping_patience": 0,
  "seed": 42
}
